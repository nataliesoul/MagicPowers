  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MagicPowersPortalPower – trace a circle to open a portal</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Portal</span>"}'
    - '// @ui {"widget":"group_start", "label":"Portal"}'
    - '// @input float minRadiusCm = 12 {"hint":"Smallest portal radius (cm)", "widget":"slider", "min":5, "max":40, "step":1}'
    - '// @input float maxRadiusCm = 60 {"hint":"Largest portal radius (cm)", "widget":"slider", "min":20, "max":150, "step":1}'
    - '// @input float spreadGain = 1.2 {"hint":"Portal radius = inter-palm distance × this while both open palms are near the portal", "widget":"slider", "min":0.3, "max":3, "step":0.05}'
    - '// @input float engageRangeCm = 90 {"hint":"Both palms must be within this distance (cm) of the portal centre to resize it", "widget":"slider", "min":20, "max":200, "step":5}'
    - '// @input float closeDistanceCm = 10 {"hint":"Inter-palm distance (cm) below which the engaged hands close the portal", "widget":"slider", "min":3, "max":30, "step":0.5}'
    - '// @input float openSec = 0.55 {"hint":"Seconds the portal takes to burst open", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input float closeSec = 0.45 {"hint":"Seconds the portal takes to collapse", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Look</span>"}'
    - '// @ui {"widget":"group_start", "label":"Look"}'
    - '// @input float starCount = 90 {"hint":"Stars visible through the portal", "widget":"slider", "min":10, "max":160, "step":5}'
    - '// @input vec4 colorRim = "{1.0, 0.82, 0.35, 1.0}" {"hint":"Rim colour (rings and runes)", "widget":"color"}'
    - '// @input vec4 colorCore = "{1.0, 0.97, 0.85, 1.0}" {"hint":"Hottest rim / star core colour", "widget":"color"}'
    - '// @input vec4 colorVoid = "{0.03, 0.01, 0.1, 0.92}" {"hint":"Colour of the dark space seen through the portal (alpha = opacity; black is transparent on Specs)", "widget":"color"}'
    - '// @input vec4 colorNebulaA = "{0.2, 0.95, 0.9, 1.0}" {"hint":"First nebula colour inside the portal", "widget":"color"}'
    - '// @input vec4 colorNebulaB = "{0.85, 0.25, 1.0, 1.0}" {"hint":"Second nebula colour inside the portal", "widget":"color"}'
    - '// @input float humVolume = 0.5 {"hint":"Volume of the otherworldly hum while the portal is open", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
