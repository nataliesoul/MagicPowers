  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MagicPowersLightningPower – arcs, sparks and bolts</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Arcs</span>"}'
    - '// @ui {"widget":"group_start", "label":"Arcs"}'
    - '// @input float arcMaxDistanceCm = 65 {"hint":"Palm-to-palm distance (cm) above which the arcs snap and vanish", "widget":"slider", "min":20, "max":120, "step":1}'
    - '// @input float maxArcs = 5 {"hint":"Maximum simultaneous arcs between the palms (closest distance)", "widget":"slider", "min":1, "max":8, "step":1}'
    - '// @input float arcSegments = 14 {"hint":"Segments per arc — more = finer jaggedness, more vertices", "widget":"slider", "min":6, "max":24, "step":1}'
    - '// @input float jitterFraction = 0.16 {"hint":"Jitter amplitude as a fraction of the arc length", "widget":"slider", "min":0.02, "max":0.4, "step":0.01}'
    - '// @input float flickerHz = 24 {"hint":"How many times per second each arc re-rolls its shape", "widget":"slider", "min":4, "max":60, "step":1}'
    - '// @input float coreWidthCm = 0.6 {"hint":"Width (cm) of the bright white core ribbon", "widget":"slider", "min":0.2, "max":2, "step":0.05}'
    - '// @input float glowWidthCm = 3.2 {"hint":"Width (cm) of the soft coloured glow ribbon", "widget":"slider", "min":0.5, "max":6, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Bolt &amp; blast</span>"}'
    - '// @ui {"widget":"group_start", "label":"Bolt & blast"}'
    - '// @input float boltRangeCm = 500 {"hint":"How far (cm) a pointed bolt travels when nothing is hit", "widget":"slider", "min":100, "max":1500, "step":10}'
    - '// @input float boltDurationSec = 0.18 {"hint":"Seconds a bolt stays visible", "widget":"slider", "min":0.05, "max":0.6, "step":0.01}'
    - '// @input float blastChargeSec = 1.5 {"hint":"Seconds of two facing fists needed for a full blast charge", "widget":"slider", "min":0.3, "max":4, "step":0.1}'
    - '// @input float blastBolts = 10 {"hint":"Number of radial bolts released by a full blast", "widget":"slider", "min":2, "max":16, "step":1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Look</span>"}'
    - '// @ui {"widget":"group_start", "label":"Look"}'
    - '// @input vec4 colorCore = "{1.0, 1.0, 1.0, 1.0}" {"hint":"Arc core colour", "widget":"color"}'
    - '// @input vec4 colorGlow = "{0.4, 0.85, 1.0, 1.0}" {"hint":"Arc glow / spark colour", "widget":"color"}'
    - '// @input bool fingertipSparks = true {"hint":"Show tiny arcs between the fingertips of an open hand"}'
    - '// @input float crackleVolume = 0.6 {"hint":"Volume of the crackle loop between the hands", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
