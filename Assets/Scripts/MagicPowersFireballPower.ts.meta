  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MagicPowersFireballPower – summon, charge and throw fire</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Casting</span>"}'
    - '// @ui {"widget":"group_start", "label":"Casting"}'
    - '// @input float chargeTimeSec = 1.4 {"hint":"Seconds of closed fist needed to reach a full charge", "widget":"slider", "min":0.3, "max":4, "step":0.1}'
    - '// @input float minChargeToLaunch = 0.15 {"hint":"Minimum charge (0..1) required before an open/push launches a fireball; below this the charge fizzles", "widget":"slider", "min":0, "max":0.8, "step":0.05}'
    - "// @input float fastOpenRate = 3.5 {\"hint\":\"Hand opening rate (1/s) that counts as a 'fast open' throw\", \"widget\":\"slider\", \"min\":1, \"max\":12, \"step\":0.25}"
    - '// @input float launchSpeedMin = 320 {"hint":"Fireball speed (cm/s) at minimum charge", "widget":"slider", "min":100, "max":1200, "step":10}'
    - '// @input float launchSpeedMax = 720 {"hint":"Fireball speed (cm/s) at full charge", "widget":"slider", "min":100, "max":1500, "step":10}'
    - '// @input float projectileGravity = 45 {"hint":"Downward acceleration on fireballs (cm/s²); 0 = straight line", "widget":"slider", "min":0, "max":400, "step":5}'
    - '// @input float maxRangeCm = 900 {"hint":"Distance (cm) after which an un-hit fireball bursts on its own", "widget":"slider", "min":100, "max":2000, "step":10}'
    - '// @input float gazeAssist = 0.35 {"hint":"How much of the throw direction follows the gaze (0 = pure palm normal, 1 = pure gaze)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float maxProjectiles = 3 {"hint":"Maximum fireballs in flight at once", "widget":"slider", "min":1, "max":8, "step":1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Look</span>"}'
    - '// @ui {"widget":"group_start", "label":"Look"}'
    - '// @input float flameHeightCm = 11 {"hint":"Height of the palm flame (cm)", "widget":"slider", "min":4, "max":25, "step":0.5}'
    - '// @input float emberRate = 40 {"hint":"Embers spawned per second per burning palm", "widget":"slider", "min":0, "max":120, "step":1}'
    - '// @input vec4 colorCore = "{1.0, 0.95, 0.65, 1.0}" {"hint":"Hottest colour at the flame core / fireball centre", "widget":"color"}'
    - '// @input vec4 colorFlame = "{1.0, 0.45, 0.08, 1.0}" {"hint":"Main flame colour", "widget":"color"}'
    - '// @input vec4 colorEmber = "{1.0, 0.25, 0.04, 1.0}" {"hint":"Ember / outer glow colour", "widget":"color"}'
    - '// @input float fireLoopVolume = 0.55 {"hint":"Volume of the crackling fire loop on each burning palm", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
