  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MagicPowersMain – orchestrates gestures, casting, world magic and the journey</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 gestureRecognizer {"hint":"Hand-tracking → gesture recognizer component"}'
    - '// @input AssignableType_2 fireballPower {"hint":"Fire magic power component"}'
    - '// @input AssignableType_3 lightningPower {"hint":"Lightning magic power component"}'
    - '// @input AssignableType_4 energyPower {"hint":"Energy sphere power component"}'
    - '// @input AssignableType_5 icePower {"hint":"Ice magic power component"}'
    - '// @input AssignableType_6 telekinesisPower {"hint":"Telekinesis power component"}'
    - '// @input AssignableType_7 portalPower {"hint":"Portal magic power component"}'
    - '// @input Asset.Material glowMaterial {"hint":"Additive UberUnlit material with vertex colour enabled — used for every billboard / ribbon batch"}'
    - '// @input Asset.Material solidMaterial {"hint":"Additive Unlit material — used for the untextured energy / charge spheres"}'
    - '// @input Asset.RenderMesh sphereMesh {"hint":"Sphere mesh used for charge spheres, energy spheres and projectile cores"}'
    - '// @input SceneObject effectsRoot {"hint":"Parent for every runtime effect object (keeps the hierarchy tidy)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Casting</span>"}'
    - '// @ui {"widget":"group_start", "label":"Casting"}'
    - '// @input float defaultPower {"hint":"Power that is active when the Lens starts", "widget":"combobox", "values":[{"label":"Fireball", "value":0}, {"label":"Lightning", "value":1}, {"label":"Energy Sphere", "value":2}, {"label":"Ice", "value":3}, {"label":"Telekinesis", "value":4}, {"label":"Portal", "value":5}]}'
    - '// @input float orbChargeSec = 1.3 {"hint":"Seconds of holding the orb between the palms for a full charge (bigger, longer-lasting effect)", "widget":"slider", "min":0.4, "max":4, "step":0.1}'
    - '// @input float castThrustSpeed = 90 {"hint":"How fast (cm/s) both hands must push forward to release the orb; lower = easier to cast, higher = fewer accidental casts", "widget":"slider", "min":40, "max":200, "step":5}'
    - '// @input float castRangeCm = 600 {"hint":"How far (cm) the gaze reaches for a surface to cast onto", "widget":"slider", "min":150, "max":900, "step":10}'
    - '// @input bool castOnPeople = true {"hint":"Let casts land on a tracked person (needs the Body Mesh object with MagicPowersBodyTarget in the scene)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Element wheel</span>"}'
    - '// @ui {"widget":"group_start", "label":"Element wheel"}'
    - '// @input float selectorHeightCm = 13 {"hint":"How far (cm) above the upturned palm the element wheel floats", "widget":"slider", "min":6, "max":30, "step":0.5}'
    - '// @input float selectorHideDelaySec = 0.7 {"hint":"Seconds the wheel stays after the palm stops facing up", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Journey</span>"}'
    - '// @ui {"widget":"group_start", "label":"Journey"}'
    - "// @input bool rememberProgress = true {\"hint\":\"Remember the wearer's spellbook and that they finished the onboarding between sessions (on device)\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Together &amp; voice</span>"}'
    - '// @ui {"widget":"group_start", "label":"Together & voice"}'
    - '// @input bool enableMultiplayer = true {"hint":"Let players in the same room share one session: wave hello or say \"multiplayer\" to open it (needs the SpectaclesSyncKit prefab, Start Mode = Off)"}'
    - "// @input bool enableVoice = true {\"hint\":\"Listen for spoken commands: an element's name switches to it, \\\"multiplayer\\\" opens a shared session\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Editor</span>"}'
    - '// @ui {"widget":"group_start", "label":"Editor"}'
    - '// @input bool editorKeyboardShortcuts = true {"hint":"In Lens Studio: keys 1-6 select a power, N = next element, M = open multiplayer, U toggles the mock palm-up gesture, B casts the current element at a tracked person"}'
    - "// @input bool mockCyclePowers = true {\"hint\":\"While the editor mock hands are active, the mock palm-up also 'pinches' so every element is previewed in turn\"}"
    - '// @input bool debugLogging {"hint":"Log power switches, casts and discoveries"}'
    - '// @ui {"widget":"group_end"}'
