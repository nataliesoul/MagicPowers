  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MagicPowersIcePower – snowflakes, ice sphere, shards and a crystal shield</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Casting</span>"}'
    - '// @ui {"widget":"group_start", "label":"Casting"}'
    - '// @input float sphereGrowSec = 1.2 {"hint":"Seconds of closed fist needed to form a full ice sphere", "widget":"slider", "min":0.3, "max":4, "step":0.1}'
    - '// @input float minSphereToShoot = 0.2 {"hint":"Minimum sphere formation (0..1) required before an open/push shoots shards; below this the sphere melts", "widget":"slider", "min":0, "max":0.8, "step":0.05}'
    - "// @input float fastOpenRate = 3.5 {\"hint\":\"Hand opening rate (1/s) that counts as a 'fast open' shot\", \"widget\":\"slider\", \"min\":1, \"max\":12, \"step\":0.25}"
    - '// @input float shardSpeedMin = 450 {"hint":"Shard speed (cm/s) for a barely formed sphere", "widget":"slider", "min":100, "max":1200, "step":10}'
    - '// @input float shardSpeedMax = 850 {"hint":"Shard speed (cm/s) for a fully formed sphere", "widget":"slider", "min":100, "max":1500, "step":10}'
    - '// @input float shardCountMin = 4 {"hint":"Shards in a volley from a barely formed sphere", "widget":"slider", "min":1, "max":12, "step":1}'
    - '// @input float shardCountMax = 9 {"hint":"Shards in a volley from a fully formed sphere", "widget":"slider", "min":1, "max":16, "step":1}'
    - '// @input float spreadDeg = 7 {"hint":"Volley spread (degrees, half-angle)", "widget":"slider", "min":0, "max":30, "step":0.5}'
    - '// @input float shardGravity = 25 {"hint":"Downward acceleration on shards (cm/s²)", "widget":"slider", "min":0, "max":300, "step":5}'
    - '// @input float maxRangeCm = 900 {"hint":"Distance (cm) after which an un-hit shard shatters on its own", "widget":"slider", "min":100, "max":2000, "step":10}'
    - '// @input float gazeAssist = 0.35 {"hint":"How much of the shot direction follows the gaze (0 = pure palm normal, 1 = pure gaze)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input bool shieldEnabled = true {"hint":"Show the crystal shield when an open palm faces away from the user"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Look</span>"}'
    - '// @ui {"widget":"group_start", "label":"Look"}'
    - '// @input float flakeCount = 10 {"hint":"Snowflakes + crystals floating above each open palm", "widget":"slider", "min":3, "max":16, "step":1}'
    - '// @input float flakeHeightCm = 9 {"hint":"Height (cm) of the snowflake cloud above the palm", "widget":"slider", "min":3, "max":20, "step":0.5}'
    - '// @input float shieldRadiusCm = 13 {"hint":"Radius (cm) of the hexagonal crystal shield", "widget":"slider", "min":6, "max":30, "step":0.5}'
    - '// @input vec4 colorCore = "{1.0, 1.0, 1.0, 1.0}" {"hint":"Brightest colour: snowflake cores, sphere centre, shard tips", "widget":"color"}'
    - '// @input vec4 colorIce = "{0.62, 0.86, 1.0, 1.0}" {"hint":"Main pale-blue ice colour", "widget":"color"}'
    - '// @input vec4 colorDeep = "{0.32, 0.58, 1.0, 1.0}" {"hint":"Deep blue used for glows and the sphere body", "widget":"color"}'
    - '// @input float shimmerVolume = 0.4 {"hint":"Volume of the icy shimmer loop over each open palm", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
